---
export interface Props {
    title: string;
    imageUrl: string;
    text: string;
    url: string;
}

const { title, imageUrl, text, url } = Astro.props;
---

<a href={url} class="card">
    <img src={imageUrl} alt={title} />
    <div class="card-content">
        <h3 class="card-title">{title}</h3>
        <p class="card-text">{text}</p>
    </div>
</a>
