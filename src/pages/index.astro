---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Strona główna">
	<div class="hero">
		<h1>Odkryj Cypr na nowo</h1>
		<p>Niezapomniane wycieczki, najlepsze samochody i rowery.</p>
		<a href="/wycieczki" class="cta-button">Zobacz nasze wycieczki</a>
	</div>

	<div class="section">
		<h2 class="section-title">Polecane wycieczki</h2>
		<div class="card-grid">
			<Card 
                title="Kyrenia i Famagusta"
                imageUrl="/images/wycieczka-kyrenia-famagusta.jpg" 
                text="Odkryj historię i kulturę północnego Cypru."
                url="/wycieczki"
            />
            <Card 
                title="Góry Troodos"
                imageUrl="/images/wycieczka-gory-troodos.jpg"
                text="Malownicze krajobrazy i tradycyjne wioski."
                url="/wycieczki"
            />
            <Card
                title="Rejs statkiem"
                imageUrl="/images/wycieczka-rejs-statkiem.jpg"
                text="Zrelaksuj się na pokładzie i podziwiaj wybrzeże."
                url="/wycieczki"
            />
		</div>
	</div>

	<div class="section">
		<h2 class="section-title">Wynajem pojazdów</h2>
		<div class="card-grid">
            <Card
                title="Samochody"
                imageUrl="/images/wynajem-samochody.jpg"
                text="Szeroki wybór nowoczesnych i komfortowych aut."
                url="/wynajem"
            />
            <Card 
                title="Rowery górskie"
                imageUrl="/images/wynajem-rowery-gorskie.jpg"
                text="Idealne na odkrywanie górskich szlaków."
                url="/wynajem"
            />
            <Card
                title="Skutery"
                imageUrl="/images/wynajem-skutery.jpg"
                text="Szybki i wygodny sposób na poruszanie się po mieście."
                url="/wynajem"
            />
		</div>
	</div>
</Layout>
