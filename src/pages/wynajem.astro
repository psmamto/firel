---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Wynajem">
    <h1 class="section-title">Wynajem Pojazdów</h1>
    <div class="card-grid">
        <Card
            title="Samochody Ekonomiczne"
            imageUrl="/images/wynajem-samochody.jpg"
            text="Małe i oszczędne, idealne do miasta."
            url="#"
        />
        <Card 
            title="SUV-y"
            imageUrl="/images/wynajem-suv.jpg"
            text="Komfort i przestrzeń dla całej rodziny."
            url="#"
        />
        <Card
            title="Kabriolety"
            imageUrl="/images/wynajem-kabriolety.jpg"
            text="Poczuj wiatr we włosach podczas jazdy wzdłuż wybrzeża."
            url="#"
        />
        <Card 
            title="Rowery górskie"
            imageUrl="/images/wynajem-rowery-gorskie.jpg"
            text="Idealne na odkrywanie górskich szlaków."
            url="#"
        />
        <Card
            title="Rowery miejskie"
            imageUrl="/images/wynajem-rowery-miejskie.jpg"
            text="Wygodny sposób na zwiedzanie miast."
            url="#"
        />
        <Card
            title="Skutery"
            imageUrl="/images/wynajem-skutery.jpg"
            text="Szybki i wygodny sposób na poruszanie się po mieście."
            url="#"
        />
    </div>
</Layout>
