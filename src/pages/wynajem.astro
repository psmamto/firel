---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Wynajem">
    <h1 class="section-title">Wynajem Pojazdów</h1>
    <div class="card-grid">
        <Card
            title="Samochody Ekonomiczne"
            imageUrl="https://images.unsplash.com/photo-1514316454348-720054cc3370?q=80&w=2070&auto=format&fit=crop"
            text="Małe i oszczędne, idealne do miasta."
            url="#"
        />
        <Card 
            title="SUV-y"
            imageUrl="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=1974&auto=format&fit=crop"
            text="Komfort i przestrzeń dla całej rodziny."
            url="#"
        />
        <Card
            title="Kabriolety"
            imageUrl="https://images.unsplash.com/photo-1541443131876-44b43de101c5?q=80&w=2070&auto=format&fit=crop"
            text="Poczuj wiatr we włosach podczas jazdy wzdłuż wybrzeża."
            url="#"
        />
        <Card 
            title="Rowery górskie"
            imageUrl="https://images.unsplash.com/photo-1576620546256-d494103173a5?q=80&w=2070&auto=format&fit=crop"
            text="Idealne na odkrywanie górskich szlaków."
            url="#"
        />
        <Card
            title="Rowery miejskie"
            imageUrl="https://images.unsplash.com/photo-1507150080056-79542bdb86c7?q=80&w=2070&auto=format&fit=crop"
            text="Wygodny sposób na zwiedzanie miast."
            url="#"
        />
        <Card
            title="Skutery"
            imageUrl="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?q=80&w=2070&auto=format&fit=crop"
            text="Szybki i wygodny sposób na poruszanie się po mieście."
            url="#"
        />
    </div>
</Layout>
