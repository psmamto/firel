---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Wycieczki">
    <h1 class="section-title">Nasze Wycieczki</h1>
    <div class="card-grid">
        <Card 
            title="Kyrenia i Famagusta"
            imageUrl="https://images.unsplash.com/photo-1592996372297-5b6c229e0efb?q=80&w=2070&auto=format&fit=crop" 
            text="Odkryj historię i kulturę północnego Cypru."
            url="#"
        />
        <Card 
            title="Góry Troodos"
            imageUrl="https://images.unsplash.com/photo-1572115312903-b7b5b7b6b1b5?q=80&w=1932&auto=format&fit=crop"
            text="Malownicze krajobrazy i tradycyjne wioski."
            url="#"
        />
        <Card
            title="Rejs statkiem"
            imageUrl="https://images.unsplash.com/photo-1603934333934-9d5841d1d8a8?q=80&w=1974&auto=format&fit=crop"
            text="Zrelaksuj się na pokładzie i podziwiaj wybrzeże."
            url="#"
        />
        <Card
            title="Nurkowanie"
            imageUrl="https://images.unsplash.com/photo-1577817042321-2a191eb3a7ce?q=80&w=2070&auto=format&fit=crop"
            text="Odkryj podwodny świat Morza Śródziemnego."
            url="#"
        />
        <Card
            title="Safari Jeepem"
            imageUrl="https://images.unsplash.com/photo-1629898569435-50232579b990?q=80&w=1964&auto=format&fit=crop"
            text="Przygoda w niedostępnych zakątkach wyspy."
            url="#"
        />
        <Card
            title="Degustacja Wina"
            imageUrl="https://images.unsplash.com/photo-1598835804218-e2181d7a86c4?q=80&w=2070&auto=format&fit=crop"
            text="Poznaj smak cypryjskich win w lokalnych winnicach."
            url="#"
        />
    </div>
</Layout>
