---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Wycieczki">
    <h1 class="section-title">Nasze Wycieczki</h1>
    <div class="card-grid">
        <Card 
            title="Kyrenia i Famagusta"
            imageUrl="/images/wycieczka-kyrenia-famagusta.jpg" 
            text="Odkryj historię i kulturę północnego Cypru."
            url="#"
        />
        <Card 
            title="Góry Troodos"
            imageUrl="/images/wycieczka-gory-troodos.jpg"
            text="Malownicze krajobrazy i tradycyjne wioski."
            url="#"
        />
        <Card
            title="Rejs statkiem"
            imageUrl="/images/wycieczka-rejs-statkiem.jpg"
            text="Zrelaksuj się na pokładzie i podziwiaj wybrzeże."
            url="#"
        />
        <Card
            title="Nurkowanie"
            imageUrl="/images/wycieczka-nurkowanie.jpg"
            text="Odkryj podwodny świat Morza Śródziemnego."
            url="#"
        />
        <Card
            title="Safari Jeepem"
            imageUrl="/images/wycieczka-safari-jeepem.jpg"
            text="Przygoda w niedostępnych zakątkach wyspy."
            url="#"
        />
        <Card
            title="Degustacja Wina"
            imageUrl="/images/wycieczka-degustacja-wina.jpg"
            text="Poznaj smak cypryjskich win w lokalnych winnicach."
            url="#"
        />
    </div>
</Layout>
